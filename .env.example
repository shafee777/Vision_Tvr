# ═════════════════════════════════════════════════════════════════════
# OPTII OPTICAL PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for development, testing, or production.
# ═════════════════════════════════════════════════════════════════════

# Application Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Server Port
PORT=5050

# Secret Key for JWT Authentication (Mandatory in production; min 32 chars)
# In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=optii_dev_insecure_jwt_secret_for_local_testing_only_32char

# JWT Token Expiry (e.g. 24h, 8h)
JWT_EXPIRES_IN=24h

# Database File Path (Defaults to data/optii.db or data/optii_prod.db)
# DB_PATH=data/optii.db

# Official Atelier WhatsApp Business Routing Number
WHATSAPP_PHONE=+919486552324

# Atelier Store Display Name
STORE_NAME=Optii Eyewear & Optical Atelier

# Allowed CORS Origins (comma-separated; in production, set to your exact domain)
# CORS_ORIGINS=https://optii.in,https://admin.optii.in
